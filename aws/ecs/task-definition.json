{
  "family": "cloudops-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::507880288914:role/cloudops-ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "cloudops-app",
      "image": "507880288914.dkr.ecr.us-east-1.amazonaws.com/cloudops-app:11",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
